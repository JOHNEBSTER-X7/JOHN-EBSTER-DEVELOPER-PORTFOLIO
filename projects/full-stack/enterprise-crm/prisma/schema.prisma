generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactStatus {
  LEAD
  QUALIFIED
  CUSTOMER
  INACTIVE
}

model Contact {
  id          String        @id @default(cuid())
  firstName   String
  lastName    String
  email       String        @unique
  company     String?
  jobTitle    String?
  phone       String?
  status      ContactStatus @default(LEAD)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([company])
}
